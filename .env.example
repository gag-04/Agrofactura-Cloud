# ==============================================================================
# AgroFactura Cloud - Environment Configuration Template (.env.example)
#
# Copy this file to .env before launching the Docker Compose cluster:
#   cp .env.example .env
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Host Port Mapping
# ------------------------------------------------------------------------------
PORT_BILLING_CORE=8000
PORT_RENDERING=8001

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=agrofactura_user
POSTGRES_PASSWORD=agrofactura_secure_password_2026
POSTGRES_DB=agrofactura_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Security & Cryptographic Tokens (Change in Production)
# ------------------------------------------------------------------------------
JWT_SECRET=development-secret-key-agrofactura-change-me-in-production-2026
JWT_EXPIRATION_HOURS=24
INTERNAL_M2M_TOKEN=internal-m2m-token-agrofactura-secret-2026

# ------------------------------------------------------------------------------
# Cloud Broker Adapters Configuration
# Set to 'true' for local development & CI testing (mock simulation)
# Set to 'false' for production with real Google Drive / SMTP credentials
# ------------------------------------------------------------------------------
GDRIVE_MOCK_MODE=true
SMTP_MOCK_MODE=true

# (Optional) SMTP Mailer credentials (used if SMTP_MOCK_MODE=false)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@agrofactura.es
SMTP_PASSWORD=your_smtp_password_here
